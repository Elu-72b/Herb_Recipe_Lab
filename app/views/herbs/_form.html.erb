<%# ハーブ登録/編集 共通フォーム %>
<div class="min-h-screen bg-gradient-to-br flex flex-col items-center space-y-3 w-full">

  <div class="max-w-4xl w-full bg-white rounded-2xl shadow-sm border border-herb-green-100 p-6 md:p-10 my-8">

    <%# タイトル %>
    <div class="flex justify-center mb-6">
      <div class="bg-herb-green-100 px-6 py-2 rounded-full shadow-sm border border-herb-green-600/20">
        <h2 class="text-xl text-herb-green-700 font-medium tracking-wide">
          <%= title %>
        </h2>
      </div>
    </div>

    <%# バリデーションエラー表示 %>
    <% if herb.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
        <p class="text-red-600 text-sm font-medium mb-1">入力内容を確認してください</p>
        <ul class="text-red-500 text-sm space-y-1">
          <% herb.errors.full_messages.each do |msg| %>
            <li>・<%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: herb, class: "space-y-2" do |form| %>

      <%# ハーブ名 %>
      <div>
        <%= form.label :name, "ハーブ名", class: "form-label" %>
        <%= form.text_field :name,
              placeholder: "例：カモミール",
              class: "form-input" %>
      </div>

      <%# 説明 %>
      <div>
        <%= form.label :description, "説明", class: "form-label" %>
        <%= form.text_area :description,
              rows: 3,
              class: "form-textarea" %>
      </div>

      <%# 風味タグ（複数選択） %>
      <div>
        <p class="form-label">風味タグ</p>
        <div class="flex flex-wrap gap-2">
          <% @flavor_tags.each do |tag| %>
            <label class="cursor-pointer">
              <%= check_box_tag "herb[flavor_tag_ids][]", tag.id,
                  herb.flavor_tag_ids.include?(tag.id),
                  id: "flavor_tag_#{tag.id}", class: "peer sr-only" %>
              <span class="tag-toggle tag-toggle-flavor"><%= tag.name %></span>
            </label>
          <% end %>
        </div>
      </div>

      <%# 効能タグ（カテゴリ別） %>
      <div>
        <p class="form-label">効能タグ</p>
        <% @grouped_functional_tags.each do |category, tags| %>
          <% next if tags.empty? %>
          <p class="text-xs text-herb-green-700/50 mt-3 mb-1 font-medium"><%= category %></p>
          <div class="flex flex-wrap gap-2">
            <% tags.each do |tag| %>
              <label class="cursor-pointer">
                <%= check_box_tag "herb[functional_tag_ids][]", tag.id,
                    herb.functional_tag_ids.include?(tag.id),
                    id: "functional_tag_#{tag.id}", class: "peer sr-only" %>
                <span class="tag-toggle tag-toggle-benefit"><%= tag.name %></span>
              </label>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# 禁忌タグ（カテゴリ別） %>
      <div>
        <p class="form-label">禁忌タグ</p>
        <% @grouped_caution_tags.each do |category, tags| %>
          <% next if tags.empty? %>
          <p class="text-xs text-red-400 mt-3 mb-1 font-medium"><%= category %></p>
          <div class="flex flex-wrap gap-2">
            <% tags.each do |tag| %>
              <label class="cursor-pointer">
                <%= check_box_tag "herb[caution_tag_ids][]", tag.id,
                    herb.caution_tag_ids.include?(tag.id),
                    id: "caution_tag_#{tag.id}", class: "peer sr-only" %>
                <span class="tag-toggle tag-toggle-caution">⚠ <%= tag.name %></span>
              </label>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# 禁忌・注意事項 %>
      <div>
        <%= form.label :caution, "禁忌・注意事項", class: "form-label" %>
        <%= form.text_area :caution,
              rows: 2,
              class: "form-textarea" %>
      </div>

      <%# 画像（new=未添付→hidden / edit=既存画像→表示、を統一） %>
      <div data-controller="image-preview">
        <%= form.label :image, "ハーブ画像", class: "form-label" %>
        <%# 既存画像 or 選択画像のプレビュー %>
        <img data-image-preview-target="preview"
            <% if herb.image.attached? %>src="<%= url_for(herb.image) %>"<% end %>
            class="<%= 'hidden' unless herb.image.attached? %> w-24 h-24 object-cover rounded-xl mt-2 mb-2"
            alt="プレビュー">
        <%# ファイル選択（ボタン化: file: バリアントで選択ボタンをスタイリング） %>
        <%= form.file_field :image, accept: Herb::ACCEPTED_CONTENT_TYPES.join(","),
              data: { image_preview_target: "input", action: "change->image-preview#preview" },
              class: "w-full text-sm text-gray-500 file:mr-3 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-medium file:bg-herb-green-100 file:text-herb-green-700 hover:file:bg-herb-green-200 file:cursor-pointer" %>
        <p class="text-xs text-herb-green-700/60 mt-1">JPEG・PNG・GIF・WebP形式、5MB以下</p>
      </div>

      <%# 保存・戻るボタン %>
      <div class="pt-2 flex items-center justify-between gap-3">
        <%= link_to "一覧に戻る", herbs_path, class: "btn-list-back" %>
        <%= form.submit submit_label, class: "btn-primary-lg" %>
      </div>

    <% end %>

  </div>

  <%= render 'shared/footer' %>
</div>