<%# app/views/drinking_logs/new.html.erb %>
<div class="min-h-screen bg-gradient-to-br flex flex-col items-center space-y-3 w-full">

  <div class="max-w-4xl w-full bg-white rounded-2xl shadow-sm border border-herb-green-100 p-6 md:p-10 my-8">

    <%# タイトル %>
    <div class="flex justify-center mb-6">
      <div class="bg-herb-green-100 px-6 py-2 rounded-full shadow-sm border border-herb-green-600/20">
        <h2 class="text-xl text-herb-green-700 font-medium tracking-wide">
          STEP 2｜感想を記録する
        </h2>
      </div>
    </div>

    <div>
      <p class="text-xl font-bold text-herb-green-800"><%= @recipe.title %></p>
      <p class="text-xs text-gray-400 mt-0.5">作成日: <%= @recipe.brewed_at %></p>
    </div>
      <%= render 'recipes/recipe_summary', recipe: @recipe %>

    <% if @drinking_log.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
        <p class="text-red-600 text-sm font-medium mb-1">入力内容を確認してください</p>
        <ul class="text-red-500 text-sm space-y-1">
          <% @drinking_log.errors.full_messages.each do |msg| %>
            <li>・<%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: [@recipe, @drinking_log], class: "space-y-6" do |f| %>

    <%= render "shared/rating_form",
          f: f,
          flavor_tags: @flavor_tags,
          flavor_mapping: DrinkingLog::FLAVOR_MAPPING %>

      <%# 公開設定 デフォルト: 非公開 %>
        <div class="flex items-center gap-3 bg-herb-green-50 rounded-xl px-4 py-3">
          <%= hidden_field_tag "recipe[is_public]", "0" %>
          <%= check_box_tag "recipe[is_public]", "1", @recipe.is_public?,
                id: "recipe_is_public",
                class: "w-4 h-4 accent-herb-green-600 rounded" %>
          <div>
            <label for="recipe_is_public" class="text-sm font-medium text-herb-green-700">このレシピを公開する</label>
            <p class="text-xs text-gray-400">オンにすると他のユーザーに表示されます</p>
          </div>
        </div>

      <%# 保存・戻るボタン %>
      <div class="pt-2 space-y-3 flex flex-col items-center">
        <%= f.submit "感想を保存する",class: "btn-primary-lg" %>
        <%= link_to "ブレンド記録に戻る", edit_recipe_path(@recipe), class: "btn-white-lg" %>
      </div>

    <% end %>
  </div>

  <%= render 'shared/footer' %>
</div>
