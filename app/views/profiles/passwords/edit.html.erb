<div class="min-h-screen bg-gradient-to-br flex flex-col items-center space-y-3 w-full">
  <div class="max-w-2xl w-full bg-white rounded-2xl shadow-sm border border-herb-green-100 p-4 md:p-5 my-5 space-y-6">
    <div class="flex justify-center mb-6">
      <div class="bg-herb-green-100 px-6 py-2 rounded-full shadow-sm border border-herb-green-600/20">
        <h2 class="text-xl text-herb-green-700 font-medium tracking-wide">パスワード変更</h2>
      </div>
    </div>

    <%= form_with model: current_user, scope: :user, url: profile_password_path, method: :patch, class: "space-y-4" do |f| %>
      <%= render "devise/shared/error_messages", resource: current_user %>

      <% [ [ :current_password, "current-password" ], [ :password, "new-password" ], [ :password_confirmation, "new-password" ] ].each do |field, ac| %>
        <div>
          <%= f.label field, class: "block text-sm text-herb-green-700 mb-1" %>
          <%= f.password_field field, required: true, autocomplete: ac,
              class: "w-full p-3 border border-herb-green-100 rounded-xl focus:ring-2 focus:ring-herb-green-600 outline-none" %>
        </div>
      <% end %>
      <p class="text-xs text-herb-green-700/70"><%= Devise.password_length.min %>文字以上で入力してください</p>

      <div class="flex justify-center gap-3 pt-2">
        <%= link_to "キャンセル", profile_path, class: "btn-white-lg" %>
        <%= f.submit "変更する", class: "btn-primary-lg" %>
      </div>
    <% end %>
  </div>
</div>
