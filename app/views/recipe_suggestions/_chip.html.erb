<%# locals: (field:, value:, variant:) %>
<%# ハーブ図鑑と同じタグカラーを使う（application.tailwind.css の .tag-toggle*）。 %>
<%# variant: "flavor"（オレンジ）/ "benefit"（ブルー）/ "caution"（レッド） %>
<%# CSS 側が .peer:checked ~ .tag-toggle-* の兄弟セレクタなので、 %>
<%# checkbox は span の直前に置き、class に peer を付ける必要がある。 %>
<%# 送信後の再描画でも選択状態が残るよう params から checked を復元する。 %>
<label class="cursor-pointer">
  <% checked = Array(params[field.delete_suffix("[]")]).include?(value) %>
  <%= check_box_tag field, value, checked, id: nil, class: "peer sr-only" %>
  <span class="tag-toggle tag-toggle-<%= variant %>"><%= value %></span>
</label>
