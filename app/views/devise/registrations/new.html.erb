<%# app/views/devise/registrations/new.html.erb %>
<div class="min-h-screen bg-gradient-to-br flex flex-col items-center space-y-3 w-full">

  <main class="flex-grow flex flex-col items-center justify-center px-4 pb-20">
    <%# terms-agreement コントローラは Google ボタン（form の外側）も制御するため、
        フォームではなくカード全体に付与している %>
    <div class="w-full max-w-md bg-white rounded-2xl shadow-sm border border-herb-green-100 p-8 md:p-10"
         data-controller="terms-agreement">
      <div class="flex justify-center mb-6">
        <div class="bg-herb-green-100 px-8 py-2 rounded-full shadow-sm border border-herb-green-600/20">
          <h2 class="text-2xl text-herb-green-700 font-medium tracking-wide">新規登録</h2>
        </div>
      </div>
      <%# Deviseのフォーム開始 %>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
            html: { class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%# ユーザー名（ER図に合わせて追加している場合） %>
        <div>
          <%= f.label :name, "ユーザー名", class: "block text-lg text-herb-green-700 mb-2 ml-1" %>
          <%= f.text_field :name, placeholder: "Herb Lover", class: "w-full p-3 border border-herb-green-100 rounded-xl focus:ring-2 focus:ring-herb-green-600 focus:border-transparent outline-none text-lg" %>
        </div>

        <%# メールアドレス %>
        <div>
          <%= f.label :email, "メールアドレス", class: "block text-lg text-herb-green-700 mb-2 ml-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "example@mail.com", class: "w-full p-3 border border-herb-green-100 rounded-xl focus:ring-2 focus:ring-herb-green-600 focus:border-transparent outline-none text-lg" %>
        </div>

        <%# パスワード %>
        <div>
          <%= f.label :password, "パスワード", class: "block text-lg text-herb-green-700 mb-2 ml-1" %>
          <%= f.password_field :password, autocomplete: "new-password", placeholder: "6文字以上", class: "w-full p-3 border border-herb-green-100 rounded-xl focus:ring-2 focus:ring-herb-green-600 focus:border-transparent outline-none text-lg" %>
        </div>

        <%# パスワード（確認用） %>
        <div>
          <%= f.label :password_confirmation, "パスワード（確認用）", class: "block text-lg text-herb-green-700 mb-2 ml-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "もう一度入力してください", class: "w-full p-3 border border-herb-green-100 rounded-xl focus:ring-2 focus:ring-herb-green-600 focus:border-transparent outline-none text-lg" %>
        </div>

        <%# 利用規約への同意 %>
        <div class="flex items-start gap-2">
          <%= check_box_tag :terms_agreement, "1", false,
                required: true,
                id: "terms_agreement",
                class: "mt-1 h-5 w-5 rounded border-herb-green-300 text-herb-green-600 focus:ring-herb-green-600",
                data: { terms_agreement_target: "checkbox", action: "change->terms-agreement#toggle" } %>
          <label for="terms_agreement" class="text-sm text-herb-green-700 leading-relaxed">
            <%= link_to "利用規約", terms_path, target: "_blank", class: "underline font-medium" %>
            および
            <%= link_to "プライバシーポリシー", privacy_path, target: "_blank", class: "underline font-medium" %>
            に同意します
          </label>
        </div>

        <%# 登録ボタン %>
        <div class="pt-4 items-center flex flex-col space-y-3">
          <%= f.submit "アカウントを作成",
                class: "btn-primary-lg disabled:opacity-50 disabled:cursor-not-allowed",
                data: { terms_agreement_target: "submit" } %>
        </div>

      <% end %>

      <%# 区切り線 %>
      <div class="flex items-center w-full max-w-xs mx-auto my-6">
        <span class="flex-grow border-t border-herb-green-100"></span>
        <span class="px-3 text-xs text-herb-green-700">または</span>
        <span class="flex-grow border-t border-herb-green-100"></span>
      </div>

      <%# Google 新規登録ボタン
          button_to は内部で <form> を生成するため、上の登録フォーム（form_for）の
          外側に置くこと。内側に置くと form がネストして送信されなくなる。
          利用規約への同意を必須にするため、フォーム送信ボタンと同じ
          terms-agreement のターゲットにして未同意時は非活性にしている。 %>
      <%# signup=true は「新規登録の意図」を示すフラグ。
          OmniAuth は request.GET（クエリ文字列）しか omniauth.params に載せないため、
          POST の hidden field ではなくパスのクエリとして渡す必要がある。
          このフラグが無いログイン画面からの認証では、未登録なら作成せず新規登録画面へ誘導する。 %>
      <%= button_to user_google_oauth2_omniauth_authorize_path(signup: "true"),
            form_class: "w-full max-w-xs mx-auto",
            form: { data: { turbo: false } },
            class: "btn-white-lg w-full flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed",
            data: { terms_agreement_target: "submit" } do %>
        <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
        </svg>
        <span>Google で新規登録</span>
      <% end %>

      <div class="text-center pt-6">
        <p class="text-herb-green-600 text-sm">既にアカウントをお持ちですか？</p>
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </main>
</div>