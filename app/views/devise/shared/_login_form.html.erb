<%# ログインフォーム %>
<div class="w-full max-w-md bg-white rounded-2xl shadow-sm border border-herb-green-100 p-4 md:p-5">
    <%# タイトル %>
    <div class="flex justify-center mb-6">
      <div class="bg-herb-green-100 px-8 py-2 rounded-full shadow-sm border border-herb-green-600/20">
        <h2 class="text-2xl text-herb-green-700 font-medium tracking-wide">ログイン</h2>
      </div>
    </div>
    <div class="flex-grow flex flex-col items-center justify-center px-4 pb-4">
        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "w-full space-y-4" }) do |f| %>
            <div>
                <%= f.label :email, "メールアドレス", class: "block text-sm font-bold text-herb-green-700 mb-1.5 ml-1" %>
                <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "example@mail.com", class: "w-full p-3 border border-herb-green-100 rounded-xl focus:ring-2 focus:ring-herb-green-600 focus:border-transparent outline-none text-sm" %>
            </div>
            <div>
                <%= f.label :password, "パスワード", class: "block text-sm font-bold text-herb-green-700 mb-1.5 ml-1" %>
                <%= f.password_field :password, autocomplete: "current-password", placeholder: "Password", class: "w-full p-3 border border-herb-green-100 rounded-xl focus:ring-2 focus:ring-herb-green-600 focus:border-transparent outline-none text-sm" %>
            </div>

            <div class="pt-4 space-y-3 flex flex-col items-center w-full max-w-xs mx-auto">
                <%= f.submit "ログイン", class: "btn-primary-lg w-full" %>
                <%= link_to "新規作成", signup_path, class: "btn-primary-lg block w-full text-center" %>
                <%= link_to "ログインせずに始める", recipes_path, class: "btn-white-lg block w-full text-center text-sm md:text-xl whitespace-nowrap leading-7" %>
            </div>
            <div class="mt-4 text-center text-sm">
                <%= link_to "パスワードをお忘れですか？", new_user_password_path, class: "text-green-700 hover:text-green-700/60" %>
            </div>
            <div class="mt-4 text-center text-xs">
                <%= link_to "利用規約", terms_path, class: "text-green-700 hover:text-green-700/60 border-b border-green-700" %>
                <%= link_to "プライバシーポリシー", privacy_path, class: "text-green-700 hover:text-green-700/60 border-b border-green-700" %>
            </div>
        <% end %>
    </div>

</div>