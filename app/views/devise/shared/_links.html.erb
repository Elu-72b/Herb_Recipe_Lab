<%- if controller_name != 'sessions' %>
  <p><%= link_to "ログイン画面に戻る", new_session_path(resource_name) %></p>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <p><%= link_to "アカウントを作成", new_registration_path(resource_name) %></p>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <p><%= link_to "パスワードを忘れた場合", new_password_path(resource_name) %></p>
<% end %>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <p><%= link_to "確認手順を受信できませんでした", new_confirmation_path(resource_name) %></p>
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <p><%= link_to "ロック解除手順を受信できませんでした", new_unlock_path(resource_name) %></p>
<% end %>

<%# OmniAuth（Google）のボタンは Devise 既定の未スタイル英語ボタンを使わず、
    各画面に自前のデザイン済みボタンを配置しているためここでは描画しない。
    - ログイン画面   : devise/shared/_login_form.html.erb
    - 新規登録画面   : devise/registrations/new.html.erb %>
