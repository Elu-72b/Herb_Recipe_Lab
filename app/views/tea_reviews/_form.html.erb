<%# 基本情報セクション %>
<div class="space-y-4">
  <h3 class="text-sm font-semibold text-herb-green-700 border-b border-herb-green-200 pb-1">基本情報</h3>

  <% if tea_review.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4">
      <p class="text-red-600 text-sm font-medium mb-1">入力内容を確認してください</p>
      <ul class="text-red-500 text-sm space-y-1">
        <% tea_review.errors.full_messages.each do |msg| %>
          <li>・<%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :brand, "メーカー名", class: "form-label" %>
    <%= f.text_field :brand, placeholder: "例: ハーブスタンド", class: "form-input" %>
  </div>

  <div>
    <%= f.label :name, "商品名", class: "form-label" %>
    <%= f.text_field :name, placeholder: "例: カモミールブレンド", class: "form-input" %>
  </div>

  <div>
    <%= f.label :purchase_place, "購入した場所", class: "form-label" %>
    <%= f.text_field :purchase_place, placeholder: "例: オンラインショップ、カルディ", class: "form-input" %>
  </div>

  <div>
    <%= f.label :description, "特徴", class: "form-label" %>
    <%= f.text_area :description, rows: 3, placeholder: "商品の特徴や原材料など", class: "form-textarea" %>
  </div>
</div>

<%# 使用ハーブ %>
<div class="space-y-2" data-controller="add-field">
  <h3 class="text-sm font-semibold text-herb-green-700 border-b border-herb-green-200 pb-1">使用ハーブ（任意）</h3>
  <p class="text-xs text-gray-400">ハーブ図鑑に登録されているハーブを選択してください</p>
  <div class="grid grid-cols-2 gap-2 max-h-48 overflow-y-auto border border-herb-green-100 rounded-xl p-3">
    <% @herbs.each do |herb| %>
      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
        <%= f.check_box :herb_ids, { multiple: true, checked: tea_review.herb_ids.include?(herb.id) }, herb.id, nil %>
        <span><%= herb.name %></span>
      </label>
    <% end %>
  </div>

  <%# その他（自由入力） %>
  <div>
    <div data-add-field-target="container" class="space-y-2">
      <% Array(tea_review.custom_herb_names).each do |herb_name| %>
        <div class="flex items-center gap-2" data-add-field-item>
          <input type="text" name="tea_review[custom_herb_names][]" value="<%= herb_name %>"
                 placeholder="ハーブ名を入力"
                 class="form-input flex-1 text-sm" />
          <button type="button" data-action="add-field#remove"
                  class="text-gray-400 hover:text-red-400 text-2xl leading-none">×</button>
        </div>
      <% end %>
    </div>

    <template data-add-field-target="template">
      <div class="flex items-center gap-2" data-add-field-item>
        <input type="text" name="tea_review[custom_herb_names][]"
               placeholder="ハーブ名を入力"
               class="form-input flex-1 text-sm" />
        <button type="button" data-action="add-field#remove"
                class="text-gray-400 hover:text-red-400 text-2xl leading-none">×</button>
      </div>
    </template>

    <button type="button" data-action="add-field#add"
            class="mt-2 flex items-center gap-1 text-sm text-herb-green-600 hover:text-herb-green-800">
      <span class="text-lg font-bold leading-none">＋</span>
      <span>その他のハーブを追加</span>
    </button>
  </div>
</div>

<%# 感想セクション %>
<div class="space-y-4">
  <h3 class="text-sm font-semibold text-herb-green-700 border-b border-herb-green-200 pb-1">感想</h3>

  <%# 評価 %>
  <%= render 'shared/rating_form', f: f, flavor_tags: @flavor_tags, flavor_mapping: TeaReview::FLAVOR_MAPPING %>

  <%# 自由な感想 %>
  <div>
    <%= f.label :impression, "感想（任意）", class: "form-label" %>
    <%= f.text_area :impression, rows: 4, placeholder: "飲んでみた感想を自由に記入してください", class: "form-textarea" %>
  </div>
</div>
