<div class="min-h-screen bg-gradient-to-br flex flex-col items-center space-y-3 w-full">
  <div class="max-w-4xl w-full bg-white rounded-2xl shadow-sm border border-herb-green-100 p-4 md:p-10 my-8">

    <div class="flex justify-center mb-6">
      <div class="bg-herb-green-100 px-6 py-2 rounded-full shadow-sm border border-herb-green-600/20">
        <h2 class="text-xl text-herb-green-700 font-medium tracking-wide">既製品レビューを登録</h2>
      </div>
    </div>

    <%= form_with model: @tea_review, class: "space-y-6" do |f| %>

      <% if @tea_review.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
          <p class="text-red-600 text-sm font-medium mb-1">入力内容を確認してください</p>
          <ul class="text-red-500 text-sm space-y-1">
            <% @tea_review.errors.full_messages.each do |msg| %>
              <li>・<%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

    <h3 class="text-sm font-semibold text-herb-green-700 border-b border-herb-green-200 pb-1">商品情報</h3>

      <%# 商品情報 %>
      <div class="space-y-3">
        <%= f.label :brand, "ブランド名", class: "form-label" %>
        <%= f.text_field :brand, placeholder: "例）ルピシア、無印良品など", class: "form-input" %>
        <%= f.label :name, "商品名", class: "form-label" %>
        <%= f.text_field :name, placeholder: "例）白桃烏龍、アールグレイなど", class: "form-input" %>
        <%= f.label :purchase_place, "購入場所", class: "form-label" %>
        <%= f.text_field :purchase_place, placeholder: "例）オンラインショップ、カルディなど", class: "form-input" %>
        <%= f.label :description, "特徴", class: "form-label" %>
        <%= f.text_area :description, rows: 3, placeholder: "商品の特徴や原材料など", class: "form-textarea" %>

        <%# 商品画像 %>
        <div data-controller="image-preview">
          <%= f.label :image, "商品画像（任意）", class: "form-label" %>
          <img data-image-preview-target="preview"
              <% if @tea_review.image.attached? %>src="<%= url_for(@tea_review.image) %>"<% end %>
              class="<%= 'hidden' unless @tea_review.image.attached? %> w-24 h-24 object-cover rounded-xl mt-2 mb-2"
              alt="プレビュー">
          <%= f.file_field :image, accept: TeaReview::ACCEPTED_CONTENT_TYPES.join(","),
                data: { image_preview_target: "input", action: "change->image-preview#preview" },
                class: "w-full text-sm text-gray-500 file:mr-3 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-medium file:bg-herb-green-100 file:text-herb-green-700 hover:file:bg-herb-green-200 file:cursor-pointer" %>
          <p class="text-xs text-herb-green-700/60 mt-1">JPEG・PNG・GIF・WebP形式、5MB以下</p>
        </div>
      </div>

      <%# ハーブ配合 %>
      <div>
        <p class="form-label">使用ハーブ（任意）</p>
        <p class="text-xs text-gray-400">　ハーブ図鑑に登録されているハーブを選択してください</p>
        <div class="space-y-3" id="recipe-herbs-fields">
          <%# 既存行（バリデーション失敗時の再表示 or 初期の1行） %>
          <%= f.fields_for :tea_review_herbs do |herb_f| %>
            <% is_custom = herb_f.object.herb_id.nil? && herb_f.object.custom_herb_name.present? %>
            <div class="flex gap-1 items-center recipe-herb-row">
              <%= herb_f.select :herb_id,
                    options_from_collection_for_select(@herbs, :id, :name, is_custom ? nil : herb_f.object.herb_id) +
                    options_for_select([["その他", "other"]], is_custom ? "other" : nil),
                    { include_blank: "ハーブを選択" },
                    class: "herb-row-select",
                    onchange: "toggleCustomHerb(this)" %>

              <%= herb_f.text_field :custom_herb_name,
                    placeholder: "ハーブ名を入力",
                    class: "herb-row-select custom-herb-name",
                    style: is_custom ? "" : "display:none" %>

              <% if herb_f.object.persisted? %>
                <%= herb_f.check_box :_destroy, class: "hidden" %>
              <% end %>
              <button type="button" onclick="this.closest('.recipe-herb-row').remove()"
                class="text-red-400 hover:text-red-600 text-2xl font-bold px-1 leading-none">
                ×
              </button>
            </div>
          <% end %>
        </div>

        <%# ハーブ追加ボタン %>
        <button type="button" id="add-herb-btn"
          class="mt-3 text-herb-green-600 text-sm border border-herb-green-300 rounded-xl
                 px-4 py-2 hover:bg-herb-green-50 transition-colors w-full">
          ＋ ハーブを追加する
        </button>
      </div>

    <h3 class="text-sm font-semibold text-herb-green-700 border-b border-herb-green-200 pb-1">評価</h3>

      <%# 評価 %>
      <%= render "shared/rating_form",
        f: f,
        flavor_tags: @flavor_tags,
        flavor_mapping: TeaReview::FLAVOR_MAPPING %>

      <div class="flex justify-between items-center mt-6">
        <%= link_to "一覧に戻る", tea_reviews_path, class: "btn-white-lg" %>
        <%= f.submit "レビューを保存する", class: "btn-primary-lg" %>
      </div>
    <% end %>

  </div>
  <%= render 'shared/footer' %>
</div>

<%# ハーブ行を動的に追加するJavaScript %>
<script data-turbo-track="reload">
  function toggleCustomHerb(select) {
    const row = select.closest(".recipe-herb-row");
    const customInput = row.querySelector(".custom-herb-name");
    if (select.value === "other") {
      customInput.style.display = "";
      customInput.removeAttribute("disabled");
    } else {
      customInput.style.display = "none";
      customInput.value = "";
      customInput.setAttribute("disabled", "disabled");
    }
  }

  document.addEventListener("turbo:load", function () {
    const addBtn = document.getElementById("add-herb-btn");
    if (!addBtn) return;
    if (addBtn.dataset.listener === "true") return;

    const herbOptions = `
      <option value="">ハーブを選択</option>
      <% @herbs.each do |herb| %>
        <option value="<%= herb.id %>"><%= herb.name %></option>
      <% end %>
      <option value="other">その他</option>
    `;

    addBtn.addEventListener("click", function () {
      const container = document.getElementById("recipe-herbs-fields");
      const herbIndex = container.querySelectorAll(".recipe-herb-row").length;

      const row = document.createElement("div");
      row.className = "flex gap-1 items-center recipe-herb-row";
      row.innerHTML = `
        <select name="tea_review[tea_review_herbs_attributes][${herbIndex}][herb_id]"
          class="herb-row-select"
          onchange="toggleCustomHerb(this)">
          ${herbOptions}
        </select>

        <input type="text"
          name="tea_review[tea_review_herbs_attributes][${herbIndex}][custom_herb_name]"
          placeholder="ハーブ名を入力"
          class="herb-row-select custom-herb-name"
          style="display:none" disabled />

        <button type="button"
          onclick="this.closest('.recipe-herb-row').remove()"
          class="text-red-400 hover:text-red-600 text-2xl font-bold px-1 leading-none">
          ×
        </button>
      `;
      container.appendChild(row);
    });

    addBtn.dataset.listener = "true";
  });
</script>