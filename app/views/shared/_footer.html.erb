<footer class="fixed bottom-0 left-0 w-full bg-herb-green-100 border-t border-herb-green-600/20 py-2 z-50">
  <nav class="flex justify-between items-center max-w-md mx-auto px-4">

    <%# ブレンド記録 %>
    <a href="<%= user_signed_in? ? home_path : recipes_path %>" class="nav-item text-herb-green-700">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="nav-icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h7.5M8.25 12h7.5m-7.5 5.25h7.5M3.75 6.75h.007v.008H3.75V6.75Zm0 5.25h.007v.008H3.75V12Zm0 5.25h.007v.008H3.75v-.008Z" />
      </svg>
      <span>ブレンド記録</span>
    </a>

    <% if user_signed_in? %>
      <%# 既製品レビュー（ログイン必須のためログイン時のみ表示） %>
      <a href="<%= tea_reviews_path %>" class="nav-item text-herb-green-700">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="nav-icon">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5.5c.4-.9.4-1.9 0-2.5M12.5 5.5c.4-.9.4-1.9 0-2.5M6.5 8.5h10l-1.5 8.5h-7L6.5 8.5zM16.5 11c1.7 0 2.75 1 2.75 2.25S18.2 15.5 16.5 15.5M4.5 18.5h13M6.5 20.5h9.5" />
        </svg>
        <span>既製品レビュー</span>
      </a>
    <% end %>

    <%# ハーブ図鑑 %>
    <a href="<%= herbs_path %>" class="nav-item text-herb-green-700">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="nav-icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
      </svg>
      <span>ハーブ図鑑</span>
    </a>

    <% if user_signed_in? %>
      <%# ブックマーク %>
      <a href="<%= bookmarks_path %>" class="nav-item text-herb-green-700">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="nav-icon">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
        </svg>
        <span>ブックマーク</span>
      </a>
    <% else %>
      <%# 利用規約（未ログイン時はブックマーク枠を置換） %>
      <a href="<%= terms_path %>" class="nav-item text-herb-green-700">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="nav-icon">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2Z" />
        </svg>
        <span>利用規約</span>
      </a>
    <% end %>

    <%# プロフィール %>
    <a href="<%= profile_path %>" class="nav-item text-herb-green-700">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="nav-icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
      </svg>
      <% if user_signed_in? %>
        <span>プロフィール</span>
      <% else %>
        <span>ログイン</span>
      <% end %>
    </a>

  </nav>
</footer>