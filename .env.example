# 画像保存（Cloudinary）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# メール送信（本番は Gmail SMTP: smtp.gmail.com:587）
# MAILER_SENDER: Devise の送信元かつ SMTP 認証ユーザー名（Gmail アドレス）。未設定だと起動時に KeyError になる
# MAILER_PASSWORD: Gmail のアプリパスワード（本番のみ使用。開発は letter_opener_web で確認するため不要）
# 本番（Render）では Environment Variables に設定すること
MAILER_SENDER=
MAILER_PASSWORD=
# ActionMailer の From（任意。未設定時は noreply@herb-recipe-lab.com）
# MAILER_FROM=

# Google ログイン（OAuth 2.0 / Google Cloud Console で取得）
# 本番（Render）では Environment Variables に設定すること
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini API（AI レシピ提案 / Google AI Studio で取得）
# https://aistudio.google.com/app/apikey
# 本番（Render）では Environment Variables に設定すること
GEMINI_API_KEY=
# 使用モデル（未設定時は Gemini::Client::DEFAULT_MODEL が使われる）
# 変更する場合は応答時間も実測すること（gemini-3-flash-preview は16〜26秒でタイムアウトの恐れ）
GEMINI_MODEL=gemini-3.1-flash-lite
