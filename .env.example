# 画像保存（Cloudinary）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# メール送信（Resend）
RESEND_API_KEY=
MAILER_SENDER=

# Google ログイン（OAuth 2.0 / Google Cloud Console で取得）
# 本番（Render）では Environment Variables に設定すること
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini API（AI レシピ提案 / Google AI Studio で取得）
# https://aistudio.google.com/app/apikey
# 本番（Render）では Environment Variables に設定すること
GEMINI_API_KEY=
# 使用モデル（未設定時は Gemini::Client::DEFAULT_MODEL が使われる）
# 変更する場合は応答時間も実測すること（gemini-3-flash-preview は16〜26秒でタイムアウトの恐れ）
GEMINI_MODEL=gemini-3.1-flash-lite
